# _headers — Security + SEO headers for static site (Cloudflare Pages / similar)
# Notes:
# - These headers implement common OWASP secure headers guidance and support strong baseline controls.
# - "Compliance" (NIST/CISA/PCI) is achieved by the overall control set + process; headers are one part.

# -------------------------
# Global (all paths)
# -------------------------
/*
  # --- Core hardening ---
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  X-XSS-Protection: 0

  # --- Clickjacking + isolation policies ---
  Cross-Origin-Resource-Policy: same-site
  Cross-Origin-Opener-Policy: same-origin

  # --- Permissions (capabilities) ---
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)

  # --- Robots / preview controls (SEO-safe) ---
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

  # --- Subresource Integrity (best-effort; browser support varies) ---
  Require-SRI-For: script style
  Integrity-Policy: require-sri-for script style

  # --- Content Security Policy (CSP) ---
  # Allows: self scripts, self XHR/fetch + your worker + your GH pages host, Cloudflare CDN font CSS + font files,
  # images from self/data/https, audio blobs, web workers from self/blob.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' https://cdnjs.cloudflare.com; style-src-attr 'none'; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://drastic-measures.rulathemtodos.workers.dev https://chattiavato-a11y.github.io https://challenges.cloudflare.com; media-src 'self' blob:; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests; block-all-mixed-content

# --------------------------------------------------------------------
# Public JSON/JS assets under /worker_files/ may be fetched by other origins
# (dash, github pages, etc). Make these explicitly cross-origin readable.
# --------------------------------------------------------------------
/worker_files/*
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept, X-Ops-Asset-Id, X-Ops-Src-Sha512-B64, X-Gabo-Origin, X-Gabo-Lang-Hint, X-Gabo-Lang-List, X-Gabo-Voice-Language, X-Gabo-Tinyml-Mode, X-Gabo-Honeypot, X-Gabo-Honeypot-Pre
  Access-Control-Max-Age: 86400
